; $VER: Install-GFOpenRegex 1.0-rc1 (6.11.2026)
; The Amiga Installer script for GFOpenRegex: regex.library, the Regex
; command and, if wanted, the SDK and documents.
; Run it from its icon, beside the GFOpenRegex drawer where the archive was unpacked.

(set @app-name "GFOpenRegex")
(set #version "1.0-rc1")
(set #drawer "GFOpenRegex")

(onerror
    (message (cat "GFOpenRegex was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-GFOpenRegex again to finish.")))

; the Installer and the CPU
(if (< @installer-version 2818051)
    (abort "GFOpenRegex needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "GFOpenRegex is built for a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists (tackon #from "Libs/regex.library") (noreq)) 1)
    (abort "The GFOpenRegex drawer is not beside Install-GFOpenRegex. Unpack the whole archive, then run Install-GFOpenRegex from there."))

(welcome (cat "This installs GFOpenRegex " #version ": regex.library, regular expressions for every program, and the Regex command."))

; the library: a newer one already in LIBS: is kept
(copylib
    (prompt "Copying regex.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/regex.library"))
    (dest "LIBS:")
    (confirm "expert"))
(complete 40)

; the command
(copyfiles
    (prompt "Copying the Regex command to C:")
    (help "Regex searches files for lines that match a regular expression, as grep does. Type Regex ? in a Shell for its template.")
    (source (tackon #from "C"))
    (dest "C:")
    (choices "Regex")
    (optional "force" "askuser"))
(complete 60)

; the SDK, the documents and the test, for programmers
(if (askbool
        (prompt "Copy the SDK (headers, SFD, FD, libregex.a), the documents and RegexTest too? Programs that use regex.library don't need them.")
        (help "They go in a drawer called GFOpenRegex in the drawer you choose next.")
        (choices "Yes" "No")
        (default 0))
    (
        (set #parent
            (askdir
                (prompt "Where should the GFOpenRegex drawer go?")
                (help "The Installer makes or updates a drawer called GFOpenRegex in the drawer you choose.")
                (default (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:"))))
        (set #dest (tackon #parent #drawer))
        (if (<> (exists #dest (noreq)) 2) (makedir #dest))
        (copyfiles
            (prompt "Copying the SDK, documents and RegexTest")
            (help @copyfiles-help)
            (source #from)
            (dest #dest)
            (pattern "~(Libs|C)")
            (optional "force" "askuser"))
        (set @default-dest #dest)))
(complete 100)
(if @pretend
    (message "Pretend: nothing was copied or changed.")
    (message (cat "GFOpenRegex " #version " is installed: regex.library in LIBS: and Regex in C:."
                  "\n\nTry it in a Shell: Regex ? shows the template.")))
(exit (quiet))
